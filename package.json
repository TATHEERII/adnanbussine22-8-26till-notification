{
  "name": "import-business-accounting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev src/worker/index.js",
    "worker:deploy": "wrangler deploy",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create importbiz-db",
    "db:migrate": "wrangler d1 migrations apply importbiz-db",
    "db:seed": "wrangler d1 execute importbiz-db --file=src/worker/db/schema.sql",
    "kv:create": "wrangler kv namespace create SESSIONS_V2",
    "kv:create:cache": "wrangler kv namespace create CACHE_V2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "wrangler": "^4.125.0"
  }
}
