# The Cloudflare Worker serves BOTH the static assets and the /api/* endpoints
# on the same origin in production, so an empty VITE_API_URL makes every
# `fetch('/api/...')` call resolve to the same origin (the Worker itself).
VITE_API_URL=

# For local development run the Worker with `npm run worker:dev` (wrangler dev)
# and create a `.env.local` (this file is gitignored by Vite) with:
#   VITE_API_URL=http://localhost:8787
# ...or just start `npm run dev` — the Vite proxy above already forwards
#   /api to localhost:8787 for you.
